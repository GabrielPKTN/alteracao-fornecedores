    AAdd(a_Regs,{c_Perg/*X1_GRUPO*/, StrZero(Len(a_Regs)+1, 2)/*X1_ORDEM*/,"UF. De:  "            /*X1_PERGUNT*/,""/*X1_PERSPA*/,""/*X1_PERENG*/,""/*X1_VARIAVL*/, "C"/*X1_TIPO*/, TamSX3("ZZB_UF")[1]    /*X1_TAMANHO*/,0/*X1_DECIMAL*/,0/*X1_PRESEL*/, "G"/*X1_GSC*/,""/*X1_VALID*/,"MV_PAR"+StrZero(Len(a_Regs)+1, 2)/*X1_VAR01*/,""/*X1_VAR01*/,""/*X1_DEF01*/,""/*X1_DEFSPA1*/,""/*X1_DEFENG1*/,""/*X1_CNT01*/,""/*X1_VAR02*/,""/*X1_DEF02*/,""/*X1_DEFSPA2*/,""/*X1_DEFENG2*/,""/*X1_CNT02*/,""/*X1_VAR03*/,""/*X1_DEF03*/,""/*X1_DEFSPA3*/,""/*X1_DEFENG3*/,""/*X1_CNT03*/,""/*X1_VAR04*/,""/*X1_DEF04*/,""/*X1_DEFSPA4*/,""/*X1_DEFENG4*/,""/*X1_CNT04*/,""/*X1_VAR05*/,""/*X1_DEF05*/,""/*X1_DEFSPA5*/,""/*X1_DEFENG5*/,""/*X1_CNT05*/,""/*X1_F3*//*X1_PYME,X1_GRPSXG,X1_HELP,X1_PICTURE,X1_IDFIL*/})
    AAdd(a_Regs,{c_Perg/*X1_GRUPO*/, StrZero(Len(a_Regs)+1, 2)/*X1_ORDEM*/,"UF. Até: "            /*X1_PERGUNT*/,""/*X1_PERSPA*/,""/*X1_PERENG*/,""/*X1_VARIAVL*/, "C"/*X1_TIPO*/, TamSX3("ZZB_UF")[1]    /*X1_TAMANHO*/,0/*X1_DECIMAL*/,0/*X1_PRESEL*/, "G"/*X1_GSC*/,""/*X1_VALID*/,"MV_PAR"+StrZero(Len(a_Regs)+1, 2)/*X1_VAR01*/,""/*X1_VAR01*/,""/*X1_DEF01*/,""/*X1_DEFSPA1*/,""/*X1_DEFENG1*/,""/*X1_CNT01*/,""/*X1_VAR02*/,""/*X1_DEF02*/,""/*X1_DEFSPA2*/,""/*X1_DEFENG2*/,""/*X1_CNT02*/,""/*X1_VAR03*/,""/*X1_DEF03*/,""/*X1_DEFSPA3*/,""/*X1_DEFENG3*/,""/*X1_CNT03*/,""/*X1_VAR04*/,""/*X1_DEF04*/,""/*X1_DEFSPA4*/,""/*X1_DEFENG4*/,""/*X1_CNT04*/,""/*X1_VAR05*/,""/*X1_DEF05*/,""/*X1_DEFSPA5*/,""/*X1_DEFENG5*/,""/*X1_CNT05*/,""/*X1_F3*//*X1_PYME,X1_GRPSXG,X1_HELP,X1_PICTURE,X1_IDFIL*/})
    AAdd(a_Regs,{c_Perg/*X1_GRUPO*/, StrZero(Len(a_Regs)+1, 2)/*X1_ORDEM*/,"Tarifa de frete de:  "/*X1_PERGUNT*/,""/*X1_PERSPA*/,""/*X1_PERENG*/,""/*X1_VARIAVL*/, "C"/*X1_TIPO*/, TamSX3("ZZB_TARFRT")[1]/*X1_TAMANHO*/,0/*X1_DECIMAL*/,0/*X1_PRESEL*/, "G"/*X1_GSC*/,""/*X1_VALID*/,"MV_PAR"+StrZero(Len(a_Regs)+1, 2)/*X1_VAR01*/,""/*X1_VAR01*/,""/*X1_DEF01*/,""/*X1_DEFSPA1*/,""/*X1_DEFENG1*/,""/*X1_CNT01*/,""/*X1_VAR02*/,""/*X1_DEF02*/,""/*X1_DEFSPA2*/,""/*X1_DEFENG2*/,""/*X1_CNT02*/,""/*X1_VAR03*/,""/*X1_DEF03*/,""/*X1_DEFSPA3*/,""/*X1_DEFENG3*/,""/*X1_CNT03*/,""/*X1_VAR04*/,""/*X1_DEF04*/,""/*X1_DEFSPA4*/,""/*X1_DEFENG4*/,""/*X1_CNT04*/,""/*X1_VAR05*/,""/*X1_DEF05*/,""/*X1_DEFSPA5*/,""/*X1_DEFENG5*/,""/*X1_CNT05*/,""/*X1_F3*//*X1_PYME,X1_GRPSXG,X1_HELP,X1_PICTURE,X1_IDFIL*/})
    AAdd(a_Regs,{c_Perg/*X1_GRUPO*/, StrZero(Len(a_Regs)+1, 2)/*X1_ORDEM*/,"Tarifa de frete até: "/*X1_PERGUNT*/,""/*X1_PERSPA*/,""/*X1_PERENG*/,""/*X1_VARIAVL*/, "C"/*X1_TIPO*/, TamSX3("ZZB_TARFRT")[1]/*X1_TAMANHO*/,0/*X1_DECIMAL*/,0/*X1_PRESEL*/, "G"/*X1_GSC*/,""/*X1_VALID*/,"MV_PAR"+StrZero(Len(a_Regs)+1, 2)/*X1_VAR01*/,""/*X1_VAR01*/,""/*X1_DEF01*/,""/*X1_DEFSPA1*/,""/*X1_DEFENG1*/,""/*X1_CNT01*/,""/*X1_VAR02*/,""/*X1_DEF02*/,""/*X1_DEFSPA2*/,""/*X1_DEFENG2*/,""/*X1_CNT02*/,""/*X1_VAR03*/,""/*X1_DEF03*/,""/*X1_DEFSPA3*/,""/*X1_DEFENG3*/,""/*X1_CNT03*/,""/*X1_VAR04*/,""/*X1_DEF04*/,""/*X1_DEFSPA4*/,""/*X1_DEFENG4*/,""/*X1_CNT04*/,""/*X1_VAR05*/,""/*X1_DEF05*/,""/*X1_DEFSPA5*/,""/*X1_DEFENG5*/,""/*X1_CNT05*/,""/*X1_F3*//*X1_PYME,X1_GRPSXG,X1_HELP,X1_PICTURE,X1_IDFIL*/})

ElseIf ( c_Modelo == "Z" )

    AAdd(a_Regs,{c_Perg/*X1_GRUPO*/, StrZero(Len(a_Regs)+1, 2)/*X1_ORDEM*/,"Modelo:  "         /*X1_PERGUNT*/,""/*X1_PERSPA*/,""/*X1_PERENG*/,""/*X1_VARIAVL*/, "C"/*X1_TIPO*/, 1/*X1_TAMANHO*/,0/*X1_DECIMAL*/,0/*X1_PRESEL*/, "G"/*X1_GSC*/, "(Empty(MV_PAR01) .OR. MV_PAR01 $ '1/2/3/4')"/*X1_VALID*/,"MV_PAR"+StrZero(Len(a_Regs)+1, 2)/*X1_VAR01*/,""/*X1_VAR01*/,""/*X1_DEF01*/,""/*X1_DEFSPA1*/,""/*X1_DEFENG1*/,""/*X1_CNT01*/,""/*X1_VAR02*/,""/*X1_DEF02*/,""/*X1_DEFSPA2*/,""/*X1_DEFENG2*/,""/*X1_CNT02*/,""/*X1_VAR03*/,""/*X1_DEF03*/,""/*X1_DEFSPA3*/,""/*X1_DEFENG3*/,""/*X1_CNT03*/,""/*X1_VAR04*/,""/*X1_DEF04*/,""/*X1_DEFSPA4*/,""/*X1_DEFENG4*/,""/*X1_CNT04*/,""/*X1_VAR05*/,""/*X1_DEF05*/,""/*X1_DEFSPA5*/,""/*X1_DEFENG5*/,""/*X1_CNT05*/,""/*X1_F3*//*X1_PYME,X1_GRPSXG,X1_HELP,X1_PICTURE,X1_IDFIL*/})
    AAdd(a_Regs,{c_Perg/*X1_GRUPO*/, StrZero(Len(a_Regs)+1, 2)/*X1_ORDEM*/,"Data de:  "        /*X1_PERGUNT*/,""/*X1_PERSPA*/,""/*X1_PERENG*/,""/*X1_VARIAVL*/, "D"/*X1_TIPO*/, 8/*X1_TAMANHO*/,0/*X1_DECIMAL*/,0/*X1_PRESEL*/, "G"/*X1_GSC*/, ""                                           /*X1_VALID*/,"MV_PAR"+StrZero(Len(a_Regs)+1, 2)/*X1_VAR01*/,""/*X1_VAR01*/,""/*X1_DEF01*/,""/*X1_DEFSPA1*/,""/*X1_DEFENG1*/,""/*X1_CNT01*/,""/*X1_VAR02*/,""/*X1_DEF02*/,""/*X1_DEFSPA2*/,""/*X1_DEFENG2*/,""/*X1_CNT02*/,""/*X1_VAR03*/,""/*X1_DEF03*/,""/*X1_DEFSPA3*/,""/*X1_DEFENG3*/,""/*X1_CNT03*/,""/*X1_VAR04*/,""/*X1_DEF04*/,""/*X1_DEFSPA4*/,""/*X1_DEFENG4*/,""/*X1_CNT04*/,""/*X1_VAR05*/,""/*X1_DEF05*/,""/*X1_DEFSPA5*/,""/*X1_DEFENG5*/,""/*X1_CNT05*/,""/*X1_F3*//*X1_PYME,X1_GRPSXG,X1_HELP,X1_PICTURE,X1_IDFIL*/})
    AAdd(a_Regs,{c_Perg/*X1_GRUPO*/, StrZero(Len(a_Regs)+1, 2)/*X1_ORDEM*/,"Data até:  "       /*X1_PERGUNT*/,""/*X1_PERSPA*/,""/*X1_PERENG*/,""/*X1_VARIAVL*/, "D"/*X1_TIPO*/, 8/*X1_TAMANHO*/,0/*X1_DECIMAL*/,0/*X1_PRESEL*/, "G"/*X1_GSC*/, ""                                           /*X1_VALID*/,"MV_PAR"+StrZero(Len(a_Regs)+1, 2)/*X1_VAR01*/,""/*X1_VAR01*/,""/*X1_DEF01*/,""/*X1_DEFSPA1*/,""/*X1_DEFENG1*/,""/*X1_CNT01*/,""/*X1_VAR02*/,""/*X1_DEF02*/,""/*X1_DEFSPA2*/,""/*X1_DEFENG2*/,""/*X1_CNT02*/,""/*X1_VAR03*/,""/*X1_DEF03*/,""/*X1_DEFSPA3*/,""/*X1_DEFENG3*/,""/*X1_CNT03*/,""/*X1_VAR04*/,""/*X1_DEF04*/,""/*X1_DEFSPA4*/,""/*X1_DEFENG4*/,""/*X1_CNT04*/,""/*X1_VAR05*/,""/*X1_DEF05*/,""/*X1_DEFSPA5*/,""/*X1_DEFENG5*/,""/*X1_CNT05*/,""/*X1_F3*//*X1_PYME,X1_GRPSXG,X1_HELP,X1_PICTURE,X1_IDFIL*/})
EndIf

U_PutX1FOC(c_Perg, a_Regs)

Return ( c_Perg )
/*/{Protheus.doc} RelLog
Faço o relatório dos logs de alteração.
@type function
@version 1.0
@author Henrique Freitas Alves
@since 19/02/2025
/*/
Static Function RelLog()

Local c_Perg    := ""
Local l_OkPerg  := .T.
Local c_Logo    := "\" + ALLTRIM(CURDIR()) + "\LogoTReport.bmp"

Private o_Report  := Nil
Private o_SecCab  := Nil

Private c_AliasRel:= GetNextAlias()
Private o_FontCab := TFont():New("Arial"/*[cName]*/,/*[uPar2]*/,12/*[nHeight]*/,/*[uPar4]*/,.T./*[lBold]*/,/*[uPar6]*/,/*[uPar7]*/,/*[uPar8]*/,/*[uPar9]*/,.F./*[lUnderline]*/,.F./*[lItalic]*/)
Private o_FontIte := TFont():New("Arial"/*[cName]*/,/*[uPar2]*/,10/*[nHeight]*/,/*[uPar4]*/,.F./*[lBold]*/,/*[uPar6]*/,/*[uPar7]*/,/*[uPar8]*/,/*[uPar9]*/,.F./*[lUnderline]*/,.F./*[lItalic]*/)

c_Perg := ValPerg("Z")

While ( .T. )

    If ( Pergunte(c_Perg, .T.) )

        If ( Empty(MV_PAR01) )

            l_OkPerg := .T.
            Exit

        EndIf
    Else
        l_OkPerg := .F.
        Exit
    EndIf
EndDo

If ( l_OkPerg )

    //Definições/preparação para impressão do relatório
    o_Report := TReport():New("FATPGR04"/*<cReport>*/, "Log de alteração."/*<cTitle>*/, c_Perg/*<uParam>*/,{|o_Report| PrintReport(o_Report)}/*<bAction>*/,"As alterações que foram feitas."/*<cDescription>*/,/*<lLandscape>*/,/*<uTotalText>*/,/*<lTotalInLine>*/,/*<cPageTText>*/,/*<lPageTInLine>*/,/*<lTPageBreak>*/,/*<nColSpace>*/)

    o_Report:SetLandscape(.T.)
    o_Report:SetLogo(c_Logo)

    //Criação da seção utilizada pelo relatório
    o_SecCab:= TRSection():New(o_Report, "Log arquivos", {c_AliasRel})
    o_SecCab:SetHeaderPage()
    o_SecCab:SetTotalInLine(.F.)

    TRCell():New(o_SecCab/*<oParent>*/, "TABELA"   /*<cName>*/, c_AliasRel/*<cAlias>*/, "Desc. Tabela"/*<cTitle>*/, ""/*<cPicture>*/,/*<nSize>*/, .T./*<lPixel>*/,/*<bBlock>*/,/*<cAlign>*/,/*<lLineBreak>*/,/*<cHeaderAlign>*/,/*<lCellBreak>*/,/*<nColSpace>*/, .T./*<lAutoSize>*/,/*<nClrBack>*/,/*<nClrFore>*/,/*<lBold>*/)
    TRCell():New(o_SecCab/*<oParent>*/, "CAMPO"    /*<cName>*/, c_AliasRel/*<cAlias>*/, "Nome campo"  /*<cTitle>*/, ""/*<cPicture>*/,/*<nSize>*/, .T./*<lPixel>*/,/*<bBlock>*/,/*<cAlign>*/,/*<lLineBreak>*/,/*<cHeaderAlign>*/,/*<lCellBreak>*/,/*<nColSpace>*/, .T./*<lAutoSize>*/,/*<nClrBack>*/,/*<nClrFore>*/,/*<lBold>*/)
    TRCell():New(o_SecCab/*<oParent>*/, "DESCCPO"  /*<cName>*/, c_AliasRel/*<cAlias>*/, "Desc. campo" /*<cTitle>*/, ""/*<cPicture>*/,/*<nSize>*/, .T./*<lPixel>*/,/*<bBlock>*/,/*<cAlign>*/,/*<lLineBreak>*/,/*<cHeaderAlign>*/,/*<lCellBreak>*/,/*<nColSpace>*/, .T./*<lAutoSize>*/,/*<nClrBack>*/,/*<nClrFore>*/,/*<lBold>*/)
    TRCell():New(o_SecCab/*<oParent>*/, "CONT_DE"  /*<cName>*/, c_AliasRel/*<cAlias>*/, "De"          /*<cTitle>*/, ""/*<cPicture>*/,/*<nSize>*/, .T./*<lPixel>*/,/*<bBlock>*/,/*<cAlign>*/,/*<lLineBreak>*/,/*<cHeaderAlign>*/,/*<lCellBreak>*/,/*<nColSpace>*/, .T./*<lAutoSize>*/,/*<nClrBack>*/,/*<nClrFore>*/,/*<lBold>*/)
    TRCell():New(o_SecCab/*<oParent>*/, "CONT_PARA"/*<cName>*/, c_AliasRel/*<cAlias>*/, "Para"        /*<cTitle>*/, ""/*<cPicture>*/,/*<nSize>*/, .T./*<lPixel>*/,/*<bBlock>*/,/*<cAlign>*/,/*<lLineBreak>*/,/*<cHeaderAlign>*/,/*<lCellBreak>*/,/*<nColSpace>*/, .T./*<lAutoSize>*/,/*<nClrBack>*/,/*<nClrFore>*/,/*<lBold>*/)
    TRCell():New(o_SecCab/*<oParent>*/, "QUEM"     /*<cName>*/, c_AliasRel/*<cAlias>*/, "Responsável" /*<cTitle>*/, ""/*<cPicture>*/,/*<nSize>*/, .T./*<lPixel>*/,/*<bBlock>*/,/*<cAlign>*/,/*<lLineBreak>*/,/*<cHeaderAlign>*/,/*<lCellBreak>*/,/*<nColSpace>*/, .T./*<lAutoSize>*/,/*<nClrBack>*/,/*<nClrFore>*/,/*<lBold>*/)
    TRCell():New(o_SecCab/*<oParent>*/, "DATA"     /*<cName>*/, c_AliasRel/*<cAlias>*/, "Data"        /*<cTitle>*/, ""/*<cPicture>*/,/*<nSize>*/, .T./*<lPixel>*/,/*<bBlock>*/,/*<cAlign>*/,/*<lLineBreak>*/,/*<cHeaderAlign>*/,/*<lCellBreak>*/,/*<nColSpace>*/, .T./*<lAutoSize>*/,/*<nClrBack>*/,/*<nClrFore>*/,/*<lBold>*/)
    TRCell():New(o_SecCab/*<oParent>*/, "HORA"     /*<cName>*/, c_AliasRel/*<cAlias>*/, "Hora"        /*<cTitle>*/, ""/*<cPicture>*/,/*<nSize>*/, .T./*<lPixel>*/,/*<bBlock>*/,/*<cAlign>*/,/*<lLineBreak>*/,/*<cHeaderAlign>*/,/*<lCellBreak>*/,/*<nColSpace>*/, .T./*<lAutoSize>*/,/*<nClrBack>*/,/*<nClrFore>*/,/*<lBold>*/)

	o_Report:PrintDialog()

	FreeObj(o_Report)
    FreeObj(o_SecCab)
EndIf

Return Nil
/*/{Protheus.doc} PrintReport
Executo a query do relatório.
@type function
@version 1.0
@author Henrique Freitas Alves
@since 18/02/2025
@param o_Report, object, O objeto de relatório.
/*/
Static Function PrintReport(o_Report)

Local c_Where   := "" 

c_Where += "%"
If ( MV_PAR01 == "1" )
    c_Where += "AND TABELA = 'DA1'"
ElseIf ( MV_PAR01 == "2" )
    c_Where += "AND TABELA = 'SA7'"
ElseIf ( MV_PAR01 == "3" )
    c_Where += "AND TABELA = 'SA1'"
ElseIf ( MV_PAR01 == "4" )
    c_Where += "AND TABELA = 'ZZB'"
EndIf
If ( !Empty(MV_PAR02) )
    c_Where += "AND   CAST(QUANDO AS DATE) >= '"+DToS(MV_PAR02)+"'"
EndIf
If ( !Empty(MV_PAR03) )
    c_Where += "AND   CAST(QUANDO AS DATE) <= '"+DToS(MV_PAR03)+"'"
EndIf
c_Where += "%"

MakeSqlExpr(o_Report:uParam)

//Altera as fontes
o_Report:oFontHeader := o_FontCab
o_Report:oFontBody 	 := o_FontIte

o_Report:Section(1):BeginQuery()	

BeginSql Alias c_AliasRel

SELECT 
		TABELA    = (SELECT X2_NOME FROM SX2010 SX2 (NOLOCK) WHERE X2_CHAVE = TABELA AND D_E_L_E_T_ = '')
	 ,  CAMPO
	 ,  DESCCPO   = CASE WHEN CAMPO = 'D_E_L_E_T_' THEN 'Exclusão'
						ELSE (SELECT X3_TITULO FROM SX3010 SX3 (NOLOCK) WHERE X3_CAMPO = CAMPO AND D_E_L_E_T_ = '')
				    END
	 ,  CONT_DE   = CASE 
						 WHEN CAMPO = 'D_E_L_E_T_' THEN ' '
						 ELSE DE
				    END
	 ,  CONT_PARA = CASE 
					     WHEN CAMPO = 'D_E_L_E_T_' THEN ' '
						 ELSE PARA
				    END
	 ,  DATA      = CONVERT(varchar, QUANDO, 103)
     ,  HORA      = LEFT(CONVERT(varchar, QUANDO, 108),5)
	 ,  QUEM

FROM TBL_LOG_ALTERACAO_PROTHEUS (NOLOCK)
WHERE ORIGEM = 'FATPGR04'
%Exp:c_Where%

EndSql

//Para pegar a query basta utilar o comando GetLastQuery()[2]

o_Report:Section(1):EndQuery(/*Array com os parametros do tipo Range*/)

o_SecCab:Print()

Return Nil
