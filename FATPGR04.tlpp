/*/{Protheus.doc} VldCodTab
Valida a tabela de preço.
@type function
@version 1.0
@author Henrique Freitas Alves
@since 11/02/2025
@param [c_Filial], character, A filial da tabela de preço.
@param c_CodTab, character, O código da tabela de preço.
@return logical, Se a tabela de preço é válida.
/*/
Static Function VldCodTab(c_Filial, c_CodTab)

Local c_Query   := ""
Local c_AliasQRY:= ""
Local l_Ret     := .F.

c_Query := "SELECT TOP 1 REC = R_E_C_N_O_ FROM "+RetSqlName("DA0")+" DA0 (NOLOCK)"+CRLF
If ( Empty(c_Filial) )
    c_Query += "WHERE DA0_CODTAB = '"+c_CodTab+"'"
Else
    c_Query += "WHERE DA0_FILIAL = '"+c_Filial+"'"
    c_Query += "AND   DA0_CODTAB = '"+c_CodTab+"'"
EndIf
c_Query += "AND   D_E_L_E_T_ = ''"

c_AliasQRY := MpSysOpenQuery(c_Query,/*c_AliasQRY*/,,"TOPCONN")

If ( (c_AliasQRY)->(!EoF()) )

    l_Ret := .T.
EndIf

(c_AliasQRY)->(DbCloseArea())

Return ( l_Ret )
/*/{Protheus.doc} VldFilial
Valida a filial.
@type function
@version 1.0
@author Henrique Freitas Alves
@since 11/02/2025
@param c_CodVend, character, O código da filial.
@return logical, Se a filial é valida.
/*/
Static Function VldFilial(c_CodFil)

Local a_AreaSM0 := SM0->(FWGetArea())
Local l_Ret     := .F.

DbSelectArea("SM0")
DbSetOrder(1) //M0_CODIGO, M0_CODFIL, R_E_C_N_O_, D_E_L_E_T_
DbGoTop()
If ( MsSeek(cEmpAnt+PadR(c_CodFil, TamSX3("DA1_FILIAL")[1])) )

    l_Ret := .T.
EndIf

FWRestArea(a_AreaSM0)

Return ( l_Ret )
