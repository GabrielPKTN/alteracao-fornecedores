@return logical, Se o campo e o valor é válido.
/*/
Static Function VldCpo(c_VlrAnt, c_NovoVlr)

Local l_Ret     := .F. 

If ( !Empty(c_NovoVlr) .AND. c_VlrAnt != c_NovoVlr )

    l_Ret := .T.
EndIf

Return ( l_Ret )
/*/{Protheus.doc} ExpArq
Exporta o arquivo com as informações das entidades de acordo com os parâmetros.
@type function
@version 1.0
@author Henrique Freitas Alves
@since 12/02/2025
@param c_Modelo, character, O modelo do relatório.
/*/
Static Function ExpArq(c_Modelo)

Local a_Cab     := {}
Local a_Linhas  := {"", CRLF, CRLF}
Local c_Perg    := ""
Local c_Query   := ""
Local c_IdentArq:= ""
Local c_AliasQRY:= ""
Local c_Caminho := cGetFile(""/*[cMascara]*/, "Selecione um Local para salvar o arquivo."/*[cTitulo]*/,/*[nMascpadrao]*/,/*[cDirinicial]*/, /*[lAbrir]*/, GETF_RETDIRECTORY+GETF_LOCALHARD+GETF_LOCALFLOPPY/*[nOpcoes]*/,/*[lArvore]*/,/*[lKeepCase]*/)
Local n_i       := 0
Local n_Handle  := 0
Local l_Perg    := .F.

If ( !Empty(c_Caminho) )

    If ( Right(c_Caminho, 1) <> "\" )
        c_Caminho += "\"
    EndIf

    If ( c_Modelo == "1" )

        c_Perg := ValPerg(c_Modelo)

        If ( Pergunte(c_Perg, .T., "Parâmetros para a alteração da tabela de preço") )

            l_Perg := .T.

            c_Query := "SELECT"+CRLF
            c_Query += "        DA1.DA1_FILIAL"+CRLF
            c_Query += "     ,  DA1.DA1_CODTAB"+CRLF
            c_Query += "     ,  DA1.DA1_CODPRO"+CRLF
            c_Query += "     ,  DA1.DA1_PRCVEN"+CRLF
            c_Query += "FROM "+RetSqlName("DA1")+" DA1 (NOLOCK)"+CRLF
            c_Query += "WHERE "

            If ( !Empty(MV_PAR01) )
                c_Query += " DA1_FILIAL >= '"+MV_PAR01+"' AND"
            EndIf

            If ( !Empty(MV_PAR02) )
                c_Query += " DA1_FILIAL <= '"+MV_PAR02+"' AND"
            EndIf

            If ( !Empty(MV_PAR03) )
                c_Query += " DA1_CODTAB >= '"+MV_PAR03+"' AND"
            EndIf

            If ( !Empty(MV_PAR04) )
                c_Query += " DA1_CODTAB <= '"+MV_PAR04+"' AND"
            EndIf

            If ( !Empty(MV_PAR05) )
                c_Query += " DA1_CODPRO >= '"+MV_PAR05+"' AND"
            EndIf

            If ( !Empty(MV_PAR06) )
                c_Query += " DA1_CODPRO <= '"+MV_PAR06+"' AND"+CRLF
            EndIf

            c_Query += " D_E_L_E_T_ = ''"+CRLF
        EndIf

    ElseIf ( c_Modelo == "2" )

        c_Perg := ValPerg(c_Modelo)

        If ( Pergunte(c_Perg, .T., "Parâmetros para a alteração do preço fixo no cliente") )

            l_Perg := .T.

            c_Query := "SELECT"+CRLF
            c_Query += "	    A7_FILIAL"+CRLF
            c_Query += "	 ,  A7_CLIENTE"+CRLF
            c_Query += "	 ,  A7_LOJA"+CRLF
            c_Query += "	 ,  A7_PRODUTO"+CRLF
            c_Query += "	 ,  A7_XPRCFIX"+CRLF
            c_Query += "	 ,  A7_XPERDS"+CRLF
            c_Query += "FROM "+RetSqlName("SA7")+" SA7 (NOLOCK)"+CRLF
            c_Query += "WHERE "

            If ( !Empty(MV_PAR01) )
                c_Query += "A7_FILIAL >= '"+MV_PAR01+"' AND "+CRLF
            EndIf
            If ( !Empty(MV_PAR02) )
    	        c_Query += "A7_FILIAL <= '"+MV_PAR02+"' AND "+CRLF
            EndIf
            If ( !Empty(MV_PAR03) )
	            c_Query += "A7_CLIENTE>= '"+MV_PAR03+"' AND "+CRLF
            EndIf
            If ( !Empty(MV_PAR04) )
    	        c_Query += "A7_CLIENTE<= '"+MV_PAR04+"' AND "+CRLF
            EndIf
            If ( !Empty(MV_PAR05) )
    	        c_Query += "A7_LOJA   >= '"+MV_PAR05+"' AND "+CRLF
            EndIf
            If ( !Empty(MV_PAR06) )
    	        c_Query += "A7_LOJA   <= '"+MV_PAR06+"' AND "+CRLF
            EndIf
            If ( !Empty(MV_PAR07) )
    	        c_Query += "A7_PRODUTO>= '"+MV_PAR07+"' AND "+CRLF
            EndIf
            If ( !Empty(MV_PAR08) )
    	        c_Query += "A7_PRODUTO<= '"+MV_PAR08+"' AND "+CRLF
            EndIf
	        c_Query += "D_E_L_E_T_ = ''"+CRLF

        EndIf

    ElseIf ( c_Modelo == "3" )

        c_Perg := ValPerg(c_Modelo)

        If ( Pergunte(c_Perg, .T., "Parâmetros para as alterações no cliente") )

            l_Perg := .T.

            c_Query := "SELECT"+CRLF
            c_Query += "		A1_COD"+CRLF
            c_Query += "	 ,  A1_LOJA"+CRLF
            c_Query += "	 ,  A1_VEND"+CRLF
            c_Query += "	 ,  A1_NREDUZ"+CRLF
            c_Query += "	 ,  A1_TABELA"+CRLF
            c_Query += "	 ,  A1_GRPVEN"+CRLF
            c_Query += "	 ,  A1_SATIV1"+CRLF
            c_Query += "FROM "+RetSqlName("SA1")+" SA1 (NOLOCK)"+CRLF
            c_Query += "WHERE "

            If ( !Empty(MV_PAR01) )

                c_Query += "A1_COD    >= '"+MV_PAR01+"' AND "+CRLF
            EndIf
            If ( !Empty(MV_PAR02) )

                c_Query += "A1_COD    <= '"+MV_PAR02+"' AND "+CRLF
            EndIf
            If ( !Empty(MV_PAR03) )

	            c_Query += "A1_LOJA   >= '"+MV_PAR03+"' AND "+CRLF
            EndIf
            If ( !Empty(MV_PAR04) )

	            c_Query += "A1_LOJA   <= '"+MV_PAR04+"' AND "+CRLF
            EndIf
            If ( !Empty(MV_PAR05) )

	            c_Query += "A1_VEND   >= '"+MV_PAR05+"' AND "+CRLF
            EndIf
            If ( !Empty(MV_PAR06) )

	            c_Query += "A1_VEND   <= '"+MV_PAR06+"' AND "+CRLF
            EndIf
            If ( !Empty(MV_PAR07) )

	            c_Query += "A1_TABELA >= '"+MV_PAR07+"' AND "+CRLF
            EndIf
            If ( !Empty(MV_PAR08) )

	            c_Query += "A1_TABELA <= '"+MV_PAR08+"' AND "+CRLF
            EndIf
            If ( !Empty(MV_PAR09) )

	            c_Query += "A1_GRPVEN >= '"+MV_PAR09+"' AND "+CRLF
            EndIf
            If ( !Empty(MV_PAR10) )

	            c_Query += "A1_GRPVEN <= '"+MV_PAR10+"' AND "+CRLF
            EndIf
            If ( !Empty(MV_PAR11) )

	            c_Query += "A1_SATIV1 >= '"+MV_PAR11+"' AND "+CRLF
            EndIf
            If ( !Empty(MV_PAR12) )

	            c_Query += "A1_SATIV1 <= '"+MV_PAR12+"' AND "+CRLF
            EndIf

	        c_Query += "D_E_L_E_T_ = '' "+CRLF
        EndIf

    ElseIf ( c_Modelo == "4" )

        c_Perg := ValPerg(c_Modelo)

        If ( Pergunte(c_Perg, .T., "Parâmetros para a alteração da matriz de frete") )

            l_Perg := .T.

            c_Query := "SELECT"+CRLF
            c_Query += "	    ZZB_FILIAL"+CRLF
            c_Query += "	 ,  ZZB_CANAL"+CRLF
            c_Query += "	 ,  ZZB_UF"+CRLF
            c_Query += "	 ,  ZZB_TARFRT"+CRLF
            c_Query += "	 ,  ZZB_VLRKG"+CRLF
            c_Query += "FROM "+RetSqlName("ZZB")+" ZZB (NOLOCK)"+CRLF
            c_Query += "WHERE "

            If ( !Empty(MV_PAR01) )
        
                c_Query += "ZZB_FILIAL >= '"+MV_PAR01+"' AND "+CRLF
            EndIf
            If ( !Empty(MV_PAR02) )
        
                c_Query += "ZZB_FILIAL <= '"+MV_PAR02+"' AND "+CRLF
            EndIf
            If ( !Empty(MV_PAR03) )
        
                c_Query += "ZZB_CANAL  >= '"+MV_PAR03+"' AND "+CRLF
            EndIf
            If ( !Empty(MV_PAR04) )
        
                c_Query += "ZZB_CANAL  <= '"+MV_PAR04+"' AND "+CRLF
            EndIf
            If ( !Empty(MV_PAR05) )
        

                c_Query += "ZZB_UF     >= '"+MV_PAR05+"' AND "+CRLF
            EndIf
            If ( !Empty(MV_PAR06) )
        
                c_Query += "ZZB_UF     <= '"+MV_PAR06+"' AND "+CRLF
            EndIf
            c_Query += "D_E_L_E_T_ = ''"+CRLF
        EndIf
    EndIf

    If ( l_Perg )

        a_Cab := RetCab(c_Modelo,/*[c_NomArq]*/, @c_IdentArq)

        a_Linhas[1] += "Modelo;"
        a_Linhas[1] += c_Modelo+";"
        a_Linhas[1] += c_IdentArq+";"

        For n_i := 1 To Len(a_Cab)

            a_Linhas[2] += a_Cab[n_i][1]+";"
            a_Linhas[3] += a_Cab[n_i][2]+";"
        Next n_i

        c_AliasQRY := MpSysOpenQuery(c_Query,/*c_AliasQRY*/,,"TOPCONN")

        If ( (c_AliasQRY)->(EoF()) )

            FWAlertInfo("Nenhum dado foi gerado!", "Informativo - ExpArq")
        Else
            If ( c_Modelo == "1" )

                While ( (c_AliasQRY)->(!EoF()) )
                    AAdd(a_Linhas, "")

                    ATail(a_Linhas) += CRLF+(c_AliasQRY)->(";"+DA1_FILIAL+";"+DA1_CODTAB+";"+DA1_CODPRO+";"+Transform(DA1_PRCVEN, PesqPict("DA1","DA1_PRCVEN")))
                    (c_AliasQRY)->(DbSkip())
                EndDo
            ElseIf ( c_Modelo == "2" )

                While ( (c_AliasQRY)->(!EoF()) )
                    AAdd(a_Linhas, "")

                    ATail(a_Linhas) += CRLF+(c_AliasQRY)->(";"+A7_FILIAL+";"+A7_CLIENTE+";"+A7_LOJA+";"+A7_PRODUTO+";"+Transform(A7_XPRCFIX, PesqPict("SA7","A7_XPRCFIX"))+";"+A7_XPERDS)
                    (c_AliasQRY)->(DbSkip())
                EndDo
            ElseIf ( c_Modelo == "3" )

                While ( (c_AliasQRY)->(!EoF()) )
                    AAdd(a_Linhas, "")

                    ATail(a_Linhas) += CRLF+(c_AliasQRY)->(A1_COD+";"+A1_LOJA+";"+A1_VEND+";"+A1_NREDUZ+";"+A1_TABELA+";"+A1_GRPVEN+";"+A1_SATIV1)
                    (c_AliasQRY)->(DbSkip())
                EndDo
            ElseIf ( c_Modelo == "4" )

                While ( (c_AliasQRY)->(!EoF()) )
                    AAdd(a_Linhas, "")

                    ATail(a_Linhas) += CRLF+(c_AliasQRY)->(";"+ZZB_FILIAL+";"+ZZB_CANAL+";"+ZZB_UF+";"+ZZB_TARFRT+";"+Transform(ZZB_VLRKG, PesqPict("ZZB","ZZB_VLRKG")))
                    (c_AliasQRY)->(DbSkip())
                EndDo
            EndIf

            n_Handle := FCreate( c_Caminho+c_IdentArq+".csv" /*<cArquivo>*/, /*[nAtributo]*/, /*[xParam3]*/, /*[lChangeCase]*/)

            If ( n_Handle = -1 )
                MsgAlert(Str(Ferror()))
            Else
                For n_i := 1 To Len(a_Linhas)

                    FWrite(n_Handle/*<nHandle>*/, a_Linhas[n_i]/*<cBuffer>*//*,[nQtdBytes]*/)
                Next n_i

                FClose(n_Handle)

                FWAlertSuccess("Arquivo criado com sucesso!", "Sucesso - FATPGR04")
                ShellExecute("OPEN", c_IdentArq+".csv", "", c_Caminho, 1)
            EndIf
        EndIf

        (c_AliasQRY)->(DbCloseArea())
    EndIf
EndIf

Return Nil
/*/{Protheus.doc} ExpTabelaPreco
Altera as tabelas de preço.
@type function
@version 1.0
@author Henrique Freitas Alves
@since 12/03/2026
@param a_CodTabelas, array, Matriz com o código da tabela e a chave de pesquisa.
/*/
Static Function ExpTabelaPreco(a_CodTabelas)

Local n_i := 0

DbSelectArea("DA0")
DbSetOrder(1) //DA0_FILIAL, DA0_CODTAB, R_E_C_N_O_, D_E_L_E_T_

For n_i := 1 To Len(a_CodTabelas)

    DbGoTop()
    If ( MsSeek(a_CodTabelas[n_i][2]) )

        U_FCSExpTAB(DA0->DA0_CODTAB, .T.)
    EndIf
Next n_i

Return Nil
