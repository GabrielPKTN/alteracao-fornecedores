User Function TesteINCFOREX()

    PREPARE ENVIRONMENT EMPRESA "99" FILIAL "01" USER "ADMIN" PASSWORD "1234"

        U_INCFOREX()

    RESET ENVIRONMENT

Return

/*/{Protheus.doc} INCFOREX
    Tela para gerenciar as ações envolvendo a tabela de fornecedores.
    @type function
    @version 1.0
    @author Gabriel Lacerda Correia
    @since 28/09/2026
/*/
User Function INCFOREX() 

    Local o_Dlg     := Nil
    Local o_MenuCab := Nil
    Local o_FontTit := Nil
    Local o_FontBut := Nil
    Local o_PainTop := Nil
    Local o_PainMid := Nil
    Local o_PainBot := Nil
    Local o_ButtonEx:= Nil
    Local o_ButtonIm:= Nil
    Local o_ButtonLg:= Nil
