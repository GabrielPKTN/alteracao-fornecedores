        o_ButtonIm := TButton():New(005/*[nRow]*/, 090/*[nCol]*/, OemToAnsi("Importar")/*[cCaption]*/, o_PainMid/*[oWnd]*/, {|| ImpArq()}/*[bAction]*/, 080/*[nWidth]*/, 018/*[nHeight]*/,/*[uParam8]*/, o_FontBut/*[oFont]*/,/*[uParam10]*/, .T./*[lPixel]*/,/*[uParam12]*/,/*[uParam13]*/,/*[uParam14]*/,/*[bWhen]*/,/*[uParam16]*/,/*[uParam17]*/)

        o_ButtonLg := TButton():New(005/*[nRow]*/, 175/*[nCol]*/, OemToAnsi("Logs")/*[cCaption]*/, o_PainMid/*[oWnd]*/, {|| RelLog() }/*[bAction]*/, 045/*[nWidth]*/, 018/*[nHeight]*/,/*[uParam8]*/, o_FontBut/*[oFont]*/,/*[uParam10]*/, .T./*[lPixel]*/,/*[uParam12]*/,/*[uParam13]*/,/*[uParam14]*/,/*[bWhen]*/,/*[uParam16]*/,/*[uParam17]*/)

        TButton():New(005/*[nRow]*/, (n_RightDlg / 2) - 50/*[nCol]*/, "Sair"/*[cCaption]*/, o_PainBot/*[oWnd]*/, {|| o_Dlg:End() }/*[bAction]*/, 045/*[nWidth]*/, 020/*[nHeight]*/,/*[uParam8]*/, o_FontBut/*[oFont]*/,/*[uParam10]*/, .T./*[lPixel]*/,/*[uParam12]*/,/*[uParam13]*/,/*[uParam14]*/,/*[bWhen]*/,/*[uParam16]*/,/*[uParam17]*/)

        o_Dlg:Activate(/*[uParam1]*/,/*[uParam2]*/,/*[uParam3]*/, .T./*[lCentered]*/,/*[bValid]*/,/*[uParam6]*/,/*[bInit]*/,/*[uParam8]*/,/*[uParam9]*/ )

    Else
        Help(Nil, Nil, "Sem autorização - INCFOREX", Nil, "Você não tem acesso para utilizar. [GR_INCFOREX]",;
            1, 0, Nil, Nil, Nil, Nil, Nil, {"Favor, solicitar para o departamento de compras."})
